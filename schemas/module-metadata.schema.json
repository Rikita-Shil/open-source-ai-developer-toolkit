{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module Metadata",
  "type": "object",
  "required": [
    "name",
    "category",
    "version",
    "author",
    "difficulty"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
